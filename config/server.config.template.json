{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": { "level": "warn" },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        { "uuid": "REPLACE_WITH_RANDOM_UUID", "flow": "xtls-rprx-vision" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_HANDSHAKE_HOST",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "REPLACE_WITH_HANDSHAKE_HOST",
            "server_port": 443
          },
          "private_key": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "short_id": ["REPLACE_WITH_SHORT_ID"]
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": { "final": "direct" }
}
