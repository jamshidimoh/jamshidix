{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "remote-dns",
        "server": "1.1.1.1",
        "server_port": 853,
        "tls": { "server_name": "cloudflare-dns.com" },
        "detour": "proxy"
      }
    ],
    "final": "remote-dns"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "JamshidixTunnel",
      "address": ["172.19.0.1/30", "fd19:73ab:2026::1/126"],
      "dns_mode": "hijack",
      "dns_address": ["172.19.0.2", "fd19:73ab:2026::2"],
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "REPLACE_WITH_SERVER_IP",
      "server_port": 443,
      "uuid": "REPLACE_WITH_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_HANDSHAKE_HOST",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "short_id": "REPLACE_WITH_SHORT_ID"
        }
      }
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "proxy"
  }
}
